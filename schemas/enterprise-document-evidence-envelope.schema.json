{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alphazede.dev/bran/enterprise-document-evidence-envelope/v1/schema.json",
  "title": "BRAN enterprise-document evidence envelope",
  "description": "Deterministic V1 envelope for structured output from Google Document AI or another owner-approved managed parser. BRAN does not parse native DOCX, XLSX, PPTX, or PDF. This schema records original media identity, parser identity, attested revision state, typed anchors, content-addressed assets, fidelity, truncation/unavailable receipts, and DLP/classification/public-boundary outcomes so validated evidence can enter queries and bounded packets. Canonical bytes are UTF-8 json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False). envelope_digest is SHA-256 of those bytes after omitting envelope_digest. normalized.digest is SHA-256 of the canonical normalized.content object. Anchor text_digest is SHA-256 of the UTF-8 text bytes. Schema cannot bind digest equality, path safety, family/media pairing, or cycle freedom; x-semantic-oracle is the mandatory stdlib checker. Fixtures are synthetic normalized outputs and do not claim native round-trip.",
  "x-semantic-oracle": "tools/ci/enterprise_contract_check.py",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "envelope_digest",
    "original",
    "parser",
    "source",
    "normalized",
    "anchors",
    "assets",
    "relations",
    "fidelity",
    "receipts",
    "hazards",
    "policy",
    "admission"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "envelope_digest": { "$ref": "#/$defs/sha256" },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "byte_length", "sha256"],
      "properties": {
        "media_type": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 20971520 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "processor", "version", "attestation"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 512 },
        "processor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 },
        "attestation": { "enum": ["attested", "unavailable"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "revision"],
      "properties": {
        "locator": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "content"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "content": { "$ref": "#/$defs/normalized_content" }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/anchor" }
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/asset" }
    },
    "relations": {
      "type": "array",
      "maxItems": 8192,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relation" }
    },
    "fidelity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["exact", "normalized", "approximated", "unsupported"]
      },
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncation", "malformed_input", "unavailable"],
      "properties": {
        "truncation": { "$ref": "#/$defs/truncation" },
        "malformed_input": { "$ref": "#/$defs/malformed_input" },
        "unavailable": { "$ref": "#/$defs/unavailable" }
      }
    },
    "hazards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_content", "external_references"],
      "properties": {
        "active_content": { "$ref": "#/$defs/active_content" },
        "external_references": { "$ref": "#/$defs/external_references" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "dlp", "public_boundary"],
      "properties": {
        "classification": { "$ref": "#/$defs/classification" },
        "dlp": { "$ref": "#/$defs/dlp" },
        "public_boundary": { "$ref": "#/$defs/public_boundary" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "packet", "query", "reasons"],
      "properties": {
        "status": { "enum": ["admitted", "rejected"] },
        "packet": { "enum": ["eligible", "ineligible"] },
        "query": { "enum": ["eligible", "ineligible"] },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9./:_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value"],
      "properties": {
        "state": { "enum": ["attested", "unavailable"] },
        "value": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] }
      }
    },
    "normalized_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "text", "language"],
      "properties": {
        "family": { "enum": ["fixed-layout", "flow", "presentation", "grid"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "language": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "role", "text", "text_digest", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "family": { "enum": ["fixed-layout", "flow", "presentation", "grid"] },
        "role": {
          "enum": [
            "heading",
            "paragraph",
            "table",
            "figure",
            "header",
            "footer",
            "title",
            "list",
            "notes",
            "shape",
            "sheet",
            "cell",
            "range",
            "chart"
          ]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "text_digest": { "$ref": "#/$defs/sha256" },
        "locator": {
          "oneOf": [
            { "$ref": "#/$defs/fixed_layout_locator" },
            { "$ref": "#/$defs/flow_locator" },
            { "$ref": "#/$defs/presentation_locator" },
            { "$ref": "#/$defs/grid_locator" }
          ]
        }
      }
    },
    "fixed_layout_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "page", "block", "bbox"],
      "properties": {
        "family": { "const": "fixed-layout" },
        "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "block": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "bbox": { "$ref": "#/$defs/bbox" }
      }
    },
    "flow_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "section", "ordinal"],
      "properties": {
        "family": { "const": "flow" },
        "section": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "presentation_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "slide", "shape", "z_index"],
      "properties": {
        "family": { "const": "presentation" },
        "slide": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "shape": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "z_index": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "grid_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "sheet", "row", "column"],
      "properties": {
        "family": { "const": "grid" },
        "sheet": { "type": "string", "minLength": 1, "maxLength": 256 },
        "row": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "y0": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "x1": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "y1": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "media_type", "byte_length", "sha256", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["derived-from", "cites", "extracts", "summarizes"] }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "omitted_bytes", "omitted_anchor_count", "reason"],
      "properties": {
        "truncated": { "type": "boolean" },
        "omitted_bytes": { "type": "integer", "minimum": 0, "maximum": 20971520 },
        "omitted_anchor_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "reason": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] }
      }
    },
    "malformed_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "reason"],
      "properties": {
        "present": { "type": "boolean" },
        "reason": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "revision", "parser_attestation"],
      "properties": {
        "features": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "revision": { "type": "boolean" },
        "parser_attestation": { "type": "boolean" }
      }
    },
    "active_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "kinds"],
      "properties": {
        "present": { "type": "boolean" },
        "kinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "external_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "count"],
      "properties": {
        "present": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "enum": ["evaluated", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["public", "public-compatible", "private", "internal"] }
          ]
        }
      }
    },
    "dlp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["not-evaluated", "passed", "findings"] },
        "findings": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "public_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "value"],
      "properties": {
        "outcome": { "enum": ["admit-export", "reject-export", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["public", "public-compatible", "private", "internal"] }
          ]
        }
      }
    }
  }
}
